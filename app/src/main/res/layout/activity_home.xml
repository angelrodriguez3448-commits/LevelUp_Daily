<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- TITULO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LEVEL UP DAILY"
                android:textAlignment="center"
                android:textColor="#F8F8F2"
                android:textSize="28sp"
                android:textStyle="bold"
                android:padding="10dp"
                android:background="#16213E"/>

            <!-- AVATAR -->
            <ImageView
                android:id="@+id/iAvatar"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:layout_marginTop="15dp"
                android:background="#0F3460"
                android:padding="6dp"
                tools:srcCompat="@tools:sample/avatars"/>

            <!-- NOMBRE -->
            <TextView
                android:id="@+id/tNombreAvatar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HERO"
                android:textAlignment="center"
                android:textColor="#FFD369"
                android:textSize="24sp"
                android:textStyle="bold"
                android:padding="10dp"/>

            <!-- STATS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#16213E"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tHP"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="HP: 100"
                    android:textColor="#FF4C4C"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:padding="4dp"/>

                <TextView
                    android:id="@+id/tOro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ORO: 0"
                    android:textColor="#FFD369"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:padding="4dp"/>

                <TextView
                    android:id="@+id/tNivel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NIVEL: 1"
                    android:textColor="#6BCB77"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:padding="4dp"/>

                <TextView
                    android:id="@+id/tXP"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="XP: 0"
                    android:textColor="#4D96FF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:padding="4dp"/>

            </LinearLayout>

            <!-- BOTONES -->
            <Button
                android:id="@+id/btnCrearMision"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="➕ NUEVA MISIÓN"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:backgroundTint="#E94560"
                android:padding="12dp"/>

            <Button
                android:id="@+id/btnTienda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💰 IR AL MERCADO"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:backgroundTint="#E94560"
                android:padding="12dp"/>

            <Button
                android:id="@+id/btnHistorial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#E94560"
                android:padding="12dp"
                android:text="📜 IR AL SALON DE LA GLORIA"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- PRINCIPALES -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚔ MISIONES PRINCIPALES"
                android:textColor="#FFD369"
                android:textStyle="bold"
                android:textSize="20sp"
                android:paddingTop="18dp"
                android:paddingBottom="8dp"/>

            <ExpandableListView
                android:id="@+id/listaPrincipales"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:background="#0F3460"
                android:divider="#FFD369"
                android:dividerHeight="2dp"/>

            <!-- SECUNDARIAS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🛡 MISIONES SECUNDARIAS"
                android:textColor="#6BCB77"
                android:textStyle="bold"
                android:textSize="20sp"
                android:paddingTop="18dp"
                android:paddingBottom="8dp"/>

            <ExpandableListView
                android:id="@+id/listaSecundarias"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:background="#0F3460"
                android:divider="#6BCB77"
                android:dividerHeight="2dp"/>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>