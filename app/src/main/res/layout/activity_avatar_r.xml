<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <!-- ESPACIO -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="20dp"/>

            <!-- TITULO -->
            <TextView
                android:id="@+id/textView4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CREA TU AVATAR"
                android:textColor="#FFD369"
                android:textSize="36sp"
                android:textStyle="bold"
                android:shadowColor="#000000"
                android:shadowDx="4"
                android:shadowDy="4"
                android:shadowRadius="2"/>

            <!-- SUBTITULO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHOOSE YOUR HERO"
                android:textColor="#F1F1F1"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingBottom="25dp"/>

            <!-- PANEL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#16213E"
                android:padding="18dp">

                <!-- NOMBRE -->
                <TextView
                    android:id="@+id/textView5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NOMBRE DEL AVATAR"
                    android:textColor="#FFD369"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingBottom="8dp"/>

                <EditText
                    android:id="@+id/EditNomAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ingresa un nombre"
                    android:textColorHint="#AAAAAA"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:padding="12dp"
                    android:background="#0F3460"
                    android:inputType="text"/>

                <!-- ESPACIO -->
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="20dp"/>

                <ImageView
                    android:id="@+id/AvatarImage"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="20dp"
                    android:background="#0F3460"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/avatar_guerrero"/>

                <!-- TITULO PERSONAJES -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SELECCIONA TU PERSONAJE"
                    android:textColor="#FFD369"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingBottom="12dp"/>


                <!-- LISTA PERSONAJES -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- PERSONAJE 1 -->
                        <ImageView
                            android:id="@+id/avatar1"
                            android:layout_width="110dp"
                            android:layout_height="110dp"
                            android:layout_margin="8dp"
                            android:background="#0F3460"
                            android:padding="6dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/avatar_guerrero"/>

                        <!-- PERSONAJE 2 -->
                        <ImageView
                            android:id="@+id/avatar2"
                            android:layout_width="110dp"
                            android:layout_height="110dp"
                            android:layout_margin="8dp"
                            android:background="#0F3460"
                            android:padding="6dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/avatar_mago"/>

                        <!-- PERSONAJE 3 -->
                        <ImageView
                            android:id="@+id/avatar3"
                            android:layout_width="110dp"
                            android:layout_height="110dp"
                            android:layout_margin="8dp"
                            android:background="#0F3460"
                            android:padding="6dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/avatar_arquero"/>

                        <!-- PERSONAJE 4 -->
                        <ImageView
                            android:id="@+id/avatar4"
                            android:layout_width="110dp"
                            android:layout_height="110dp"
                            android:layout_margin="8dp"
                            android:background="#0F3460"
                            android:padding="6dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/avatar_paladin"/>

                    </LinearLayout>

                </HorizontalScrollView>

            </LinearLayout>

            <!-- ESPACIO -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="30dp"/>

            <!-- BOTON FINAL -->
            <Button
                android:id="@+id/btnRegistro"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:text="⚔ CREAR HEROE"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="20sp"
                android:backgroundTint="#E94560"
                android:padding="14dp"/>

            <!-- TEXTO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR QUEST BEGINS NOW"
                android:textColor="#AAAAAA"
                android:textStyle="italic"
                android:textSize="12sp"
                android:paddingTop="20dp"/>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>