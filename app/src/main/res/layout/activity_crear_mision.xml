<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="25dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="NUEVA MISIÓN"
                android:textColor="@color/gold_text"
                android:textSize="32sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="30dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/input_container_bg"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TÍTULO DE LA MISIÓN"
                    android:textColor="@color/gold_text"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/editTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@color/input_field_bg"
                    android:hint="Ej: Derrotar al Dragón"
                    android:textColorHint="#5A6C8D"
                    android:textColor="@color/white"
                    android:paddingStart="15dp"
                    android:inputType="text"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DESCRIPCIÓN"
                    android:textColor="@color/gold_text"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/editMultiDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:background="@color/input_field_bg"
                    android:gravity="start|top"
                    android:hint="Describe tu aventura..."
                    android:textColorHint="#5A6C8D"
                    android:textColor="@color/white"
                    android:padding="15dp"
                    android:inputType="textMultiLine"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FECHA LÍMITE"
                    android:textColor="@color/gold_text"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvFecha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="- / - / -"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:layout_marginBottom="10dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnDatePicker"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/button_style"
                    android:backgroundTint="#4A5C7D"
                    android:text="Seleccionar fecha"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SUBMISIONES"
                android:textColor="@color/gold_text"
                android:textStyle="bold"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:id="@+id/containerSubMisiones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:minHeight="20dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAñadirSubM"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/button_style"
                android:backgroundTint="#2E3A59"
                android:text="+ Añadir submisión"
                android:textColor="@color/white" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCrearMision"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/button_style"
                android:text="⚔ GUARDAR MISIÓN"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>